# Vazio = PGlite local em ./.pglite (sem Docker). Em produção: URL do PostgreSQL.
DATABASE_URL=
# Segredo para assinar a sessão de login (32+ caracteres aleatórios).
AUTH_SECRET=
CRON_SECRET=
# fake | telegram (ADR 8)
MESSAGE_SENDER=fake
# Do @BotFather. Nunca commitar.
TELEGRAM_BOT_TOKEN=
# Usuário do bot, sem @ (ex.: biblioteca_escola_bot)
TELEGRAM_BOT_USERNAME=
# Letras, números, _ e - ; o mesmo valor vai no setWebhook (npm run telegram:setup)
TELEGRAM_WEBHOOK_SECRET=
# Endereço público do site, usado para registrar o webhook
APP_URL=
TZ=America/Sao_Paulo
# Só desenvolvimento, até o login (T3.1) existir: bibliotecaria | professor | coordenacao
DEV_SESSION_ROLE=bibliotecaria
